# Cara yang benar: `node tools/make-env.mjs`
# (script itu membangkitkan kunci burner baru, mempertahankan yang sudah ada, dan tidak pernah
#  mencetak nilai kunci — hanya address)
#
# SEMUA kunci di sini harus wallet burner testnet. Jangan pernah memakai kunci yang pernah
# memegang dana nyata, di chain mana pun.

CHAIN_ID=97
RPC_URL=https://bsc-testnet.publicnode.com
RPC_URL_ALT=https://bsc-testnet-rpc.publicnode.com

